# Copy to server/.env and fill in from your password manager.
# Never commit server/.env. The browser never receives these values.

# Alpaca (paper-trading keys, used for market data)
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=

# EODHD (free plan, delayed quotes)
EODHD_API_TOKEN=

# SEC EDGAR: contact name/email for the User-Agent header (no key needed)
SEC_EDGAR_USER_AGENT=

# Anthropic (Claude only), with a monthly cap enforced by the server
ANTHROPIC_API_KEY=
ANTHROPIC_MONTHLY_BUDGET_USD=

# Server
SESSION_SECRET=
DATABASE_PATH=./data/terminal.db
PORT=3001
